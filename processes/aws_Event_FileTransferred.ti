#region Prolog
#==============================================================================
#                             aws_Event_FileTransferred
#
#  This script will be executed after an upload or download event occurs and
#  it will be provided the information regarding the transfer status, filename,
#  and file size.
#
#     Date     WHO  Description
#  ----------  ---  ----------------------------------------------------
#  05/06/2024  SWG  Created
#  03/14/2025 CWW Added Post Upload Processing
#  05/01/2026 Ty: added Yardi Account Mapping processing
#==============================================================================

IF (LONG(psSync) > 0);
     SYNCHRONIZED(psSync);
ENDIF;

#==============================================================================
#                           CONFIGURATION SECTION
#==============================================================================
sUser = TM1User();
sProcessName = GetProcessName();
sTimeStamp = TIMST( NOW, '\Y-\m-\d(\h\i\s)' );
sUniqueID = NumbertoString(INT(RAND()*10000));
sUniqueName = Expand('%sProcessName%_%sTimeStamp%_%sUniqueID%' );
sTempName = Expand('_tmp_%sUniqueName%' );

sLogPath = '/Logs/Processes/';
sLogFile = sLogPath | sUniqueName | '.log';
sSourceFolder = '/uploads/';


# --- Values
FALSE = 0;
TRUE = 1;
bDebug = TRUE;

# --- Constants


cubEmailConfig = 'sys_Email Config';



#==============================================================================
#                        PARAMETER SECTION
#==============================================================================
sEvent = pEvent;
sPath = pPath;
sFilename = pFilename;
nFileSize = pFilesize;
nElapsed = pElapsedTime;
sStatus = pStatus;
sError = pError;

nError = 0;
#==============================================================================
#                           PROCESS LOGIC SECTION
#==============================================================================

# --- Log the transfer (if in debug mode)
If( bDebug = TRUE);
    AsciiOutput( sLogFile, 'pEvent', pEvent, 'pPath', pPath, 'pSubdirectory', pSubdirectory, 'pFilename', pFilename, 
        'pFilesize', NumberToString( pFilesize ), 'pElapsedTime', NumberToString( pElapsedTime ), 
        'pStatus', pStatus, 'pError', pError );
EndIf;

sMsg =  'pEvent: ' |  pEvent | ', pPath: ' | pPath | ', pSubdirectory: ' | pSubdirectory | ', pFilename: ' | pFilename | 
        ', pFilesize: ' | NumberToString( pFilesize ) | ', pElapsedTime: ' | NumberToString( pElapsedTime ) | 
        ', pStatus: ' | pStatus |  ', pError: ' | pError;
LogOutput( 'INFO', sMsg );


# --- If there was an error, report it
If( sError @<> '' );
    ItemReject( sError );
    ProcessQuit;    
EndIf;

#------------------------------------------------------------------------------
#                       Post-Process Uploads
#------------------------------------------------------------------------------
If( sEvent @= 'upload' );
    sMsg = Expand('File uploaded: %pFilename% ' );
   LogOutput( 'INFO', sMsg );

EndIf;

#------------------------------------------------------------------------------
#                       Post-Process Downloads
#------------------------------------------------------------------------------
If( sEvent @= 'download' );
    # --- Put download post-processing code here
EndIf;


sReturnType = IF( nError = ProcessExitByQuit()
    , 'ProcessExityByQuit - Process failed a validation.  Check Logs.'
    , IF( nError = ProcessExitSeriousError()
        ,  'ProcessExitSeriousError.   Unknown issue.  Check logs.'
        , IF( nError = ProcessExitOnInit()
            , Expand('ProcessExitOnInit.  Probably missing or empty source file.  Check "%sFullFilename%"')
            , IF( nError = ProcessExitByBreak()
                , 'Process Break.  Process skipped to Epilog.  Check logs.'
                , IF( nError = ProcessExitNormal()
                    , 'Process completed successfully.'
                    , Expand('Process Failed with error code %nError% code.  Check logs.'))))));

sEmailMsg = Expand('%sTimeStamp% %sEvent% %sReturnType%');
sSubject = Expand('Stage Loader: %sProcessName%');
sRecipients = LOWER(CellGetS( cubEmailConfig, sProcessName, 'Recipients' ));


ExecuteProcess( 'aws_SendMail', 'RecipientList', sRecipients, 'Subject', sSubject, 'Message', sEmailMsg );

    
#endregion