#region Prolog
#==============================================================================
#                             aws_DownloadToAWS
#
#  This script will issue an event request to AWS to initiate a download of
#  a file into the SFTP directory.
#
#  Requirements:
#      File must exist and be placed in the configured download path
#
#     Date     WHO  Description
#  ----------  ---  ----------------------------------------------------
#  05/06/2024  SWG  Created
#
#==============================================================================

#==============================================================================
#                           CONFIGURATION SECTION
#==============================================================================
sUser = TM1User();
sProcessName = GetProcessName();
sTimeStamp = TIMST( NOW, '\Y-\m-\d(\h\i\s)' );
sUniqueID = NumbertoString(INT(RAND()*10000));
sUniqueName = Expand('%sProcessName%_%sTimeStamp%_%sUniqueID%' );
sTempName = Expand('_tmp_%sUniqueName%' );

sLogPath = '/Logs/Processes/';
sLogFile = sLogPath | sUniqueName | '.log';

# --- Values
FALSE = 0;
TRUE = 1;
bDebug = TRUE;


#==============================================================================
#                        PARAMETER SECTION
#==============================================================================
sFilename = '"' | Filename | '"';
sSFTPPath = '"' | SFTPPath | '"';


#==============================================================================
#                           PROCESS LOGIC SECTION
#==============================================================================

IF( LONG(TRIM(SFTPPath)) > 0 );
sBody = Expand( '{
    "event": "download",
    "filepath":  %sFilename%,
    "sftpPath":  %sSFTPPath%
}');
ELSE;
sBody = Expand( '{
    "event": "download",
    "filepath":  %sFilename%
}');
ENDIF;

# --- Execute the event
ExecuteProcess( 'aws_PostEvent', 'EventBody', sBody );
#endregion
#region Epilog



    
#endregion